// Tempel isi file ini di https://dbdiagram.io lalu export sebagai gambar (PNG/PDF)

Table users {
  id int [pk, increment]
  name varchar(100) [not null]
  email varchar(150) [not null, unique]
  phone varchar(20)
  created_at timestamptz [not null, default: `now()`]
}

Table categories {
  id int [pk, increment]
  name varchar(80) [not null, unique]
}

Table locations {
  id int [pk, increment]
  name varchar(120) [not null, unique]
}

Table reports {
  id int [pk, increment]
  user_id int [not null]
  category_id int [not null]
  location_id int [not null]
  type varchar(12) [not null, note: 'hilang | ditemukan']
  item_name varchar(150) [not null]
  description text
  event_time timestamptz [not null, default: `now()`]
  status varchar(20) [not null, default: 'masih_dicari', note: 'masih_dicari | sudah_ditemukan | sudah_dikembalikan']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table claims {
  id int [pk, increment]
  report_id int [not null]
  claimer_id int [not null]
  message text
  status varchar(10) [not null, default: 'pending', note: 'pending | approved | rejected']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (report_id, claimer_id) [unique]
  }
}

Ref: reports.user_id > users.id [delete: cascade]
Ref: reports.category_id > categories.id [delete: restrict]
Ref: reports.location_id > locations.id [delete: restrict]
Ref: claims.report_id > reports.id [delete: cascade]
Ref: claims.claimer_id > users.id [delete: cascade]
